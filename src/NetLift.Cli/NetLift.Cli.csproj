<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.48.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.48.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetLift.Core\NetLift.Core.csproj" />
    <ProjectReference Include="..\NetLift.Analysis\NetLift.Analysis.csproj" />
    <ProjectReference Include="..\NetLift.Transforms\NetLift.Transforms.csproj" />
    <ProjectReference Include="..\NetLift.Validation\NetLift.Validation.csproj" />
    <ProjectReference Include="..\NetLift.Git\NetLift.Git.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Metadata -->
    <PackageId>NetLift</PackageId>
    <Version>1.0.0</Version>
    <Authors>Michał Wojciechowski</Authors>
    <Description>CLI tool for automated migration of .NET Framework applications to .NET 8+. Supports MVC5, EF6, WCF, and web.config transformations.</Description>
    <PackageTags>dotnet;migration;netframework;aspnetcore;mvc;ef6;efcore;wcf;grpc</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/wojciechowskiapp/NetLift</RepositoryUrl>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>netlift</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

</Project>
